@misc{rfc7503,
  author="A. Lindem and J. Arkko",
  title="{OSPFv3 Autoconfiguration}",
  howpublished="RFC 7503 (Proposed Standard)",
  series="Internet Request for Comments",
  type="RFC",
  number="7503",
  year=2015,
  month=apr,
  issn="2070-1721",
