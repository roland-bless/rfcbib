@misc{rfc8822,
  author="D. {Allan (Ed.)} and D. Eastlake and D. Woolley",
  title="{5G Wireless Wireline Convergence User Plane Encapsulation (5WE)}",
  howpublished="RFC 8822 (Informational)",
