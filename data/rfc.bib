@misc{rfc5286,
  author="A. {Atlas (Ed.)} and A. {Zinin (Ed.)}",
  title="{Basic Specification for IP Fast Reroute: Loop-Free Alternates}",
  howpublished="RFC 5286 (Proposed Standard)",
  series="Internet Request for Comments",
  type="RFC",
  number="5286",
  year=2008,
  month=sep,
  issn="2070-1721",
  publisher="RFC Editor",
