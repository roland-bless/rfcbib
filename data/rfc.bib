@misc{rfc6353,
  author="W. Hardaker",
  title="{Transport Layer Security (TLS) Transport Model for the Simple Network Management Protocol (SNMP)}",
  howpublished="RFC 6353 (Internet Standard)",
  series="Internet Request for Comments",
