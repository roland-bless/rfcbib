@misc{rfc8882,
  author="C. Huitema and D. Kaiser",
  title="{DNS-Based Service Discovery (DNS-SD) Privacy and Security Requirements}",
  howpublished="RFC 8882 (Informational)",
  series="Internet Request for Comments",
  type="RFC",
  number="8882",
  year=2020,
  month=sep,
  issn="2070-1721",
  publisher="RFC Editor",
  institution="RFC Editor",
  organization="RFC Editor",
  address="Fremont, CA, USA",
  url="https://www.rfc-editor.org/rfc/rfc8882.txt",
  key="RFC 8882",
  abstract={DNS-SD (DNS-based Service Discovery) normally discloses information about devices offering and requesting services.  This information includes hostnames, network parameters, and possibly a further description of the corresponding service instance.  Especially when mobile devices engage in DNS-based Service Discovery at a public hotspot, serious privacy problems arise.  We analyze the requirements of a privacy-respecting discovery service.},
  keywords="Multicast DNS, mDNS",
  doi="10.17487/RFC8882",
  }

@misc{rfc8883,
  author="T. Herbert",
  title="{ICMPv6 Errors for Discarding Packets Due to Processing Limits}",
  howpublished="RFC 8883 (Proposed Standard)",
  series="Internet Request for Comments",
  type="RFC",
  number="8883",
  year=2020,
  month=sep,
  issn="2070-1721",
  publisher="RFC Editor",
  institution="RFC Editor",
  organization="RFC Editor",
  address="Fremont, CA, USA",
  url="https://www.rfc-editor.org/rfc/rfc8883.txt",
  key="RFC 8883",
  abstract={Network nodes may discard packets if they are unable to process protocol headers of packets due to processing constraints or limits.  When such packets are dropped, the sender receives no indication, so it cannot take action to address the cause of discarded packets.  This specification defines several new ICMPv6 errors that can be sent by a node that discards packets because it is unable to process the protocol headers.  A node that receives such an ICMPv6 error may use the information to diagnose packet loss and may modify what it sends in future packets to avoid subsequent packet discards.},
  keywords="extension Headers, destination Options, Hop-by-Hop Options",
  doi="10.17487/RFC8883",
  }

@misc{rfc8884,
  author="J. Seedorf and M. Arumaithurai and A. Tagami and K. Ramakrishnan and N. Blefari-Melazzi",
  title="{Research Directions for Using Information-Centric Networking (ICN) in Disaster Scenarios}",
