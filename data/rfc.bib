@misc{rfc5944,
  author="C. {Perkins (Ed.)}",
  title="{IP Mobility Support for IPv4, Revised}",
  howpublished="RFC 5944 (Proposed Standard)",
  series="Internet Request for Comments",
  type="RFC",
