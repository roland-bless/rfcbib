@misc{rfc5220,
  author="A. Matsumoto and T. Fujisaki and R. Hiromi and K. Kanayama",
  title="{Problem Statement for Default Address Selection in Multi-Prefix Environments: Operational Issues of RFC 3484 Default Rules}",
