@misc{rfc8746,
  author="C. {Bormann (Ed.)}",
  title="{Concise Binary Object Representation (CBOR) Tags for Typed Arrays}",
  howpublished="RFC 8746 (Proposed Standard)",
  series="Internet Request for Comments",
  type="RFC",
  number="8746",
