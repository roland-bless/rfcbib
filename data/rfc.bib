@misc{rfc8642,
  author="J. Borkenhagen and R. Bush and R. Bonica and S. Bayraktar",
  title="{Policy Behavior for Well-Known BGP Communities}",
  howpublished="RFC 8642 (Proposed Standard)",
  series="Internet Request for Comments",
  type="RFC",
  number="8642",
  year=2019,
  month=aug,
  issn="2070-1721",
  publisher="RFC Editor",
  institution="RFC Editor",
  organization="RFC Editor",
  address="Fremont, CA, USA",
  url="https://www.rfc-editor.org/rfc/rfc8642.txt",
  key="RFC 8642",
  abstract={Well-known BGP communities are manipulated differently across various current implementations, resulting in difficulties for operators.  Network operators should deploy consistent community handling across their networks while taking the inconsistent behaviors from the various BGP implementations into consideration.  This document recommends specific actions to limit future inconsistency: namely, BGP implementors must not create further inconsistencies from this point forward.  These behavioral changes, though subtle, actually update RFC 1997.},
  keywords="Operations, Inter-Provider Communication",
  doi="10.17487/RFC8642",
  }

@misc{rfc8643,
  author="A. Johnston and B. Aboba and A. Hutton and R. Jesske and T. Stach",
  title="{An Opportunistic Approach for Secure Real-time Transport Protocol (OSRTP)}",
  howpublished="RFC 8643 (Informational)",
  series="Internet Request for Comments",
  type="RFC",
  number="8643",
  year=2019,
  month=aug,
  issn="2070-1721",
  publisher="RFC Editor",
  institution="RFC Editor",
  organization="RFC Editor",
  address="Fremont, CA, USA",
  url="https://www.rfc-editor.org/rfc/rfc8643.txt",
  key="RFC 8643",
  abstract={Opportunistic Secure Real-time Transport Protocol (OSRTP) is an implementation of the Opportunistic Security mechanism, as defined in RFC 7435, applied to the Real-time Transport Protocol (RTP).  OSRTP allows encrypted media to be used in environments where support for encryption is not known in advance and is not required.  OSRTP does not require Session Description Protocol (SDP) extensions or features and is fully backwards compatible with existing implementations using encrypted and authenticated media and implementations that do not encrypt or authenticate media packets.  OSRTP is not specific to any key management technique for Secure RTP (SRTP).  OSRTP is a transitional approach useful for migrating existing deployments of real-time communications to a fully encrypted and authenticated state.},
  keywords="srtp, opportunistic security, encryption, best effort, osrtp",
  doi="10.17487/RFC8643",
  }

@misc{rfc8645,
  author="S. {Smyshlyaev (Ed.)}",
  title="{Re-keying Mechanisms for Symmetric Keys}",
  howpublished="RFC 8645 (Informational)",
  series="Internet Request for Comments",
  type="RFC",
