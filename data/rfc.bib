  title="{Terminology for Describing Internet Connectivity}",
  howpublished="RFC 4084 (Best Current Practice)",
  series="Internet Request for Comments",
  type="RFC",
  number="4084",
  year=2005,
  month=may,
  issn="2070-1721",
