@misc{rfc9280,
  author="P. {Saint-Andre (Ed.)}",
  title="{RFC Editor Model (Version 3)}",
  howpublished="RFC 9280 (Informational)",
  series="Internet Request for Comments",
  type="RFC",
  number="9280",
  year=2022,
