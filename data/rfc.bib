@misc{rfc7624,
  author="R. Barnes and B. Schneier and C. Jennings and T. Hardie and B. Trammell and C. Huitema and D. Borkmann",
  title="{Confidentiality in the Face of Pervasive Surveillance: A Threat Model and Problem Statement}",
