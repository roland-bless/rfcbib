@misc{rfc5225,
  author="G. Pelletier and K. Sandlund",
  title="{RObust Header Compression Version 2 (ROHCv2): Profiles for RTP, UDP, IP, ESP and UDP-Lite}",
  howpublished="RFC 5225 (Proposed Standard)",
  series="Internet Request for Comments",
  type="RFC",
  number="5225",
  year=2008,
