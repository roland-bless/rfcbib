@misc{rfc7865,
  author="R. Ravindranath and P. Ravindran and P. Kyzivat",
  title="{Session Initiation Protocol (SIP) Recording Metadata}",
  howpublished="RFC 7865 (Proposed Standard)",
  series="Internet Request for Comments",
  type="RFC",
  number="7865",
  year=2016,
  month=may,
  issn="2070-1721",
