@misc{rfc9099,
  author="É. Vyncke and K. Chittimaneni and M. Kaeo and E. Rey",
  title="{Operational Security Considerations for IPv6 Networks}",
  howpublished="RFC 9099 (Informational)",
  series="Internet Request for Comments",
  type="RFC",
