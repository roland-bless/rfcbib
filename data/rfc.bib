  organization="RFC Editor",
  address="Fremont, CA, USA",
  url="https://www.rfc-editor.org/rfc/rfc8645.txt",
  key="RFC 8645",
  abstract={A certain maximum amount of data can be safely encrypted when encryption is performed under a single key. This amount is called the ``key lifetime''. This specification describes a variety of methods for increasing the lifetime of symmetric keys. It provides two types of re-keying mechanisms based on hash functions and block ciphers that can be used with modes of operations such as CTR, GCM, CBC, CFB, and OMAC. This document is a product of the Crypto Forum Research Group (CFRG) in the IRTF.},
  keywords="re-keying, key, key lifetime, encryption mode, mode of operation",
  doi="10.17487/RFC8645",
  }

@misc{rfc8649,
