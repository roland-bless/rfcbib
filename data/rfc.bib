@misc{rfc7810,
  author="S. {Previdi (Ed.)} and S. Giacalone and D. Ward and J. Drake and Q. Wu",
  title="{IS-IS Traffic Engineering (TE) Metric Extensions}",
  howpublished="RFC 7810 (Proposed Standard)",
  series="Internet Request for Comments",
  type="RFC",
  number="7810",
  year=2016,
  month=may,
