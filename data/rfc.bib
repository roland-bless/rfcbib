  title="{Mapping Characters for Classes of the Preparation, Enforcement, and Comparison of Internationalized Strings (PRECIS)}",
  howpublished="RFC 7790 (Informational)",
  series="Internet Request for Comments",
  type="RFC",
  number="7790",
