@misc{rfc8584,
  author="J. {Rabadan (Ed.)} and S. {Mohanty (Ed.)} and A. Sajassi and J. Drake and K. Nagaraj and S. Sathappan",
  title="{Framework for Ethernet VPN Designated Forwarder Election Extensibility}",
  howpublished="RFC 8584 (Proposed Standard)",
