  title="{TCP over Second (2.5G) and Third (3G) Generation Wireless Networks}",
  howpublished="RFC 3481 (Best Current Practice)",
  series="Internet Request for Comments",
  type="RFC",
  number="3481",
  year=2003,
  month=feb,
  issn="2070-1721",
