  title="{Mobile IPv4 Extension for Carrying Network Access Identifiers}",
  howpublished="RFC 3846 (Proposed Standard)",
  series="Internet Request for Comments",
  type="RFC",
  number="3846",
  year=2004,
  month=jun,
  issn="2070-1721",
