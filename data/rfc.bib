  title="{Encapsulation for Bit Index Explicit Replication (BIER) in MPLS and Non-MPLS Networks}",
  howpublished="RFC 8296 (Proposed Standard)",
  series="Internet Request for Comments",
  type="RFC",
  number="8296",
  year=2018,
  month=jan,
  issn="2070-1721",
