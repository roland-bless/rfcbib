@misc{rfc7172,
  author="D. {Eastlake 3rd} and M. Zhang and P. Agarwal and R. Perlman and D. Dutt",
  title="{Transparent Interconnection of Lots of Links (TRILL): Fine-Grained Labeling}",
  howpublished="RFC 7172 (Proposed Standard)",
