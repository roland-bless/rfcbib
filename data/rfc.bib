@misc{rfc8739,
  author="Y. Sheffer and D. Lopez and O. Gonzalez de Dios and A. Pastor Perales and T. Fossati",
  title="{Support for Short-Term, Automatically Renewed (STAR) Certificates in the Automated Certificate Management Environment (ACME)}",
  howpublished="RFC 8739 (Proposed Standard)",
  series="Internet Request for Comments",
  type="RFC",
