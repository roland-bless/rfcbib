@misc{rfc3670,
  author="B. Moore and D. Durham and J. Strassner and A. Westerinen and W. Weiss",
  title="{Information Model for Describing Network Device QoS Datapath Mechanisms}",
  howpublished="RFC 3670 (Proposed Standard)",
