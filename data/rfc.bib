@misc{rfc8102,
  author="P. {Sarkar (Ed.)} and S. Hegde and C. Bowers and H. Gredler and S. Litkowski",
  title="{Remote-LFA Node Protection and Manageability}",
  howpublished="RFC 8102 (Proposed Standard)",
  series="Internet Request for Comments",
  type="RFC",
  number="8102",
  year=2017,
  month=mar,
  issn="2070-1721",
