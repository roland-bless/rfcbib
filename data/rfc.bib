@misc{rfc6226,
  author="B. Joshi and A. Kessler and D. McWalter",
  title="{PIM Group-to-Rendezvous-Point Mapping}",
  howpublished="RFC 6226 (Proposed Standard)",
  series="Internet Request for Comments",
  type="RFC",
