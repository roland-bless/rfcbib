  keywords="RPKI, validation, RRDP",
  doi="10.17487/RFC8488",
  }

@misc{rfc8489,
  author="M. Petit-Huguenin and G. Salgueiro and J. Rosenberg and D. Wing and R. Mahy and P. Matthews",
  title="{Session Traversal Utilities for NAT (STUN)}",
  howpublished="RFC 8489 (Proposed Standard)",
  series="Internet Request for Comments",
  type="RFC",
