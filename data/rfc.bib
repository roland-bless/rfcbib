@misc{rfc8653,
  author="A. Yegin and D. Moses and S. Jeon",
  title="{On-Demand Mobility Management}",
  howpublished="RFC 8653 (Informational)",
  series="Internet Request for Comments",
  type="RFC",
  number="8653",
  year=2019,
  month=oct,
  issn="2070-1721",
  publisher="RFC Editor",
  institution="RFC Editor",
  organization="RFC Editor",
  address="Fremont, CA, USA",
  url="https://www.rfc-editor.org/rfc/rfc8653.txt",
  key="RFC 8653",
  abstract={Applications differ with respect to whether they need session continuity and/or IP address reachability.  The network providing the same type of service to any mobile host and any application running on the host yields inefficiencies, as described in RFC 7333.  This document defines a new concept of enabling applications to influence the network's mobility services (session continuity and/or IP address reachability) on a per-socket basis, and suggests extensions to the networking stack's API to accommodate this concept.},
  doi="10.17487/RFC8653",
  }

@misc{rfc8654,
  author="R. Bush and K. Patel and D. Ward",
  title="{Extended Message Support for BGP}",
  howpublished="RFC 8654 (Proposed Standard)",
  series="Internet Request for Comments",
  type="RFC",
  number="8654",
  year=2019,
  month=oct,
  issn="2070-1721",
  publisher="RFC Editor",
  institution="RFC Editor",
  organization="RFC Editor",
  address="Fremont, CA, USA",
  url="https://www.rfc-editor.org/rfc/rfc8654.txt",
  key="RFC 8654",
  abstract={The BGP specification (RFC 4271) mandates a maximum BGP message size of 4,096 octets.  As BGP is extended to support new Address Family Identifiers (AFIs), Subsequent AFIs (SAFIs), and other features, there is a need to extend the maximum message size beyond 4,096 octets.  This document updates the BGP specification by extending the maximum message size from 4,096 octets to 65,535 octets for all messages except for OPEN and KEEPALIVE messages.},
  keywords="border gateway protocol, address family identifiers, afi",
  doi="10.17487/RFC8654",
  }

@misc{rfc8655,
  author="N. Finn and P. Thubert and B. Varga and J. Farkas",
  title="{Deterministic Networking Architecture}",
  howpublished="RFC 8655 (Proposed Standard)",
  series="Internet Request for Comments",
  type="RFC",
  number="8655",
  year=2019,
  month=oct,
  issn="2070-1721",
  publisher="RFC Editor",
  institution="RFC Editor",
  organization="RFC Editor",
  address="Fremont, CA, USA",
  url="https://www.rfc-editor.org/rfc/rfc8655.txt",
  key="RFC 8655",
  abstract={This document provides the overall architecture for Deterministic Networking (DetNet), which provides a capability to carry specified unicast or multicast data flows for real-time applications with extremely low data loss rates and bounded latency within a network domain.  Techniques used include 1) reserving data-plane resources for individual (or aggregated) DetNet flows in some or all of the intermediate nodes along the path of the flow, 2) providing explicit routes for DetNet flows that do not immediately change with the network topology, and 3) distributing data from DetNet flow packets over time and/or space to ensure delivery of each packet's data in spite of the loss of a path.  DetNet operates at the IP layer and delivers service over lower-layer technologies such as MPLS and Time- Sensitive Networking (TSN) as defined by IEEE 802.1.},
  keywords="TSN, Bounded Latency, Reliable Networking, Available Networking",
  doi="10.17487/RFC8655",
  }

@misc{rfc8656,
  author="T. {Reddy (Ed.)} and A. {Johnston (Ed.)} and P. Matthews and J. Rosenberg",
  title="{Traversal Using Relays around NAT (TURN): Relay Extensions to Session Traversal Utilities for NAT (STUN)}",
  howpublished="RFC 8656 (Proposed Standard)",
  series="Internet Request for Comments",
  type="RFC",
  number="8656",
  year=2020,
  month=feb,
  issn="2070-1721",
  publisher="RFC Editor",
  institution="RFC Editor",
  organization="RFC Editor",
  address="Fremont, CA, USA",
  url="https://www.rfc-editor.org/rfc/rfc8656.txt",
  key="RFC 8656",
  abstract={If a host is located behind a NAT, it can be impossible for that host to communicate directly with other hosts (peers) in certain situations. In these situations, it is necessary for the host to use the services of an intermediate node that acts as a communication relay. This specification defines a protocol, called ``Traversal Using Relays around NAT'' (TURN), that allows the host to control the operation of the relay and to exchange packets with its peers using the relay. TURN differs from other relay control protocols in that it allows a client to communicate with multiple peers using a single relay address. The TURN protocol was designed to be used as part of the Interactive Connectivity Establishment (ICE) approach to NAT traversal, though it can also be used without ICE. This document obsoletes RFCs 5766 and 6156.},
  keywords="NAT, TURN, STUN, ICE",
  doi="10.17487/RFC8656",
  }

@misc{rfc8657,
  author="H. Landau",
  title="{Certification Authority Authorization (CAA) Record Extensions for Account URI and Automatic Certificate Management Environment (ACME) Method Binding}",
  howpublished="RFC 8657 (Proposed Standard)",
  series="Internet Request for Comments",
  type="RFC",
  number="8657",
  year=2019,
  month=nov,
  issn="2070-1721",
  publisher="RFC Editor",
  institution="RFC Editor",
  organization="RFC Editor",
  address="Fremont, CA, USA",
  url="https://www.rfc-editor.org/rfc/rfc8657.txt",
  key="RFC 8657",
  abstract={The Certification Authority Authorization (CAA) DNS record allows a domain to communicate an issuance policy to Certification Authorities (CAs) but only allows a domain to define a policy with CA-level granularity.  However, the CAA specification (RFC 8659) also provides facilities for an extension to admit a more granular, CA-specific policy.  This specification defines two such parameters: one allowing specific accounts of a CA to be identified by URIs and one allowing specific methods of domain control validation as defined by the Automatic Certificate Management Environment (ACME) protocol to be required.},
  doi="10.17487/RFC8657",
  }

@misc{rfc8658,
  author="S. {Jiang (Ed.)} and Y. {Fu (Ed.)} and C. Xie and T. Li and M. {Boucadair (Ed.)}",
  title="{RADIUS Attributes for Softwire Mechanisms Based on Address plus Port (A+P)}",
  howpublished="RFC 8658 (Proposed Standard)",
  series="Internet Request for Comments",
  type="RFC",
  number="8658",
  year=2019,
  month=nov,
  issn="2070-1721",
  publisher="RFC Editor",
  institution="RFC Editor",
  organization="RFC Editor",
  address="Fremont, CA, USA",
  url="https://www.rfc-editor.org/rfc/rfc8658.txt",
  key="RFC 8658",
  abstract={IPv4-over-IPv6 transition mechanisms provide IPv4 connectivity services over IPv6 native networks during the IPv4/IPv6 coexistence period. DHCPv6 options have been defined to configure clients for Lightweight 4over6, Mapping of Address and Port with Encapsulation (MAP-E), Mapping of Address and Port using Translation (MAP-T) unicast softwire mechanisms, and multicast softwires. However, in many networks, configuration information is stored in an Authentication, Authorization, and Accounting (AAA) server, which utilizes the Remote Authentication Dial In User Service (RADIUS) protocol to provide centralized management for users. When a new transition mechanism is developed, new RADIUS attributes need to be defined correspondingly. This document defines new RADIUS attributes to carry softwire configuration parameters based on Address plus Port from a AAA server to a Broadband Network Gateway. Both unicast and multicast attributes are covered.},
  keywords="IPv6 Transition, MAP-E, MAP-T, Lightweight 4over6, RADIUS, address sharing, authorization, AAA, provisioning",
  doi="10.17487/RFC8658",
  }

@misc{rfc8659,
  author="P. Hallam-Baker and R. Stradling and J. Hoffman-Andrews",
  title="{DNS Certification Authority Authorization (CAA) Resource Record}",
  howpublished="RFC 8659 (Proposed Standard)",
  series="Internet Request for Comments",
  type="RFC",
  number="8659",
  year=2019,
  month=nov,
  issn="2070-1721",
  publisher="RFC Editor",
  institution="RFC Editor",
  organization="RFC Editor",
  address="Fremont, CA, USA",
  url="https://www.rfc-editor.org/rfc/rfc8659.txt",
  key="RFC 8659",
  abstract={The Certification Authority Authorization (CAA) DNS Resource Record allows a DNS domain name holder to specify one or more Certification Authorities (CAs) authorized to issue certificates for that domain name. CAA Resource Records allow a public CA to implement additional controls to reduce the risk of unintended certificate mis-issue. This document defines the syntax of the CAA record and rules for processing CAA records by CAs. This document obsoletes RFC 6844.},
  keywords="certificate, ca, pki, issue, issuance, wildcard",
  doi="10.17487/RFC8659",
  }

@misc{rfc8660,
  author="A. {Bashandy (Ed.)} and C. {Filsfils (Ed.)} and S. Previdi and B. Decraene and S. Litkowski and R. Shakir",
  title="{Segment Routing with the MPLS Data Plane}",
  howpublished="RFC 8660 (Proposed Standard)",
  series="Internet Request for Comments",
  type="RFC",
  number="8660",
  year=2019,
  month=dec,
  issn="2070-1721",
  publisher="RFC Editor",
  institution="RFC Editor",
  organization="RFC Editor",
  address="Fremont, CA, USA",
  url="https://www.rfc-editor.org/rfc/rfc8660.txt",
  key="RFC 8660",
  abstract={Segment Routing (SR) leverages the source-routing paradigm.  A node steers a packet through a controlled set of instructions, called segments, by prepending the packet with an SR header.  In the MPLS data plane, the SR header is instantiated through a label stack.  This document specifies the forwarding behavior to allow instantiating SR over the MPLS data plane (SR-MPLS).},
  keywords="SR, SR-MPLS",
  doi="10.17487/RFC8660",
  }

@misc{rfc8661,
  author="A. {Bashandy (Ed.)} and C. {Filsfils (Ed.)} and S. Previdi and B. Decraene and S. Litkowski",
  title="{Segment Routing MPLS Interworking with LDP}",
  howpublished="RFC 8661 (Proposed Standard)",
  series="Internet Request for Comments",
  type="RFC",
  number="8661",
  year=2019,
  month=dec,
  issn="2070-1721",
  publisher="RFC Editor",
  institution="RFC Editor",
  organization="RFC Editor",
  address="Fremont, CA, USA",
  url="https://www.rfc-editor.org/rfc/rfc8661.txt",
  key="RFC 8661",
  abstract={A Segment Routing (SR) node steers a packet through a controlled set of instructions, called segments, by prepending the packet with an SR header. A segment can represent any instruction, topological or service based. SR allows enforcing a flow through any topological path while maintaining per-flow state only at the ingress node to the SR domain. The Segment Routing architecture can be directly applied to the MPLS data plane with no change in the forwarding plane. This document describes how Segment Routing MPLS operates in a network where LDP is deployed and in the case where SR-capable and non-SR-capable nodes coexist.},
  keywords="SR-MPLS",
  doi="10.17487/RFC8661",
  }

@misc{rfc8662,
  author="S. Kini and K. Kompella and S. Sivabalan and S. Litkowski and R. Shakir and J. Tantsura",
  title="{Entropy Label for Source Packet Routing in Networking (SPRING) Tunnels}",
  howpublished="RFC 8662 (Proposed Standard)",
  series="Internet Request for Comments",
