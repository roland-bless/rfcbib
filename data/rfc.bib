@misc{rfc6510,
  author="L. Berger and G. Swallow",
  title="{Resource Reservation Protocol (RSVP) Message Formats for Label Switched Path (LSP) Attributes Objects}",
  howpublished="RFC 6510 (Proposed Standard)",
