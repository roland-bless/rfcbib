@misc{rfc3401,
  author="M. Mealling",
  title="{Dynamic Delegation Discovery System (DDDS) Part One: The Comprehensive DDDS}",
  howpublished="RFC 3401 (Informational)",
  series="Internet Request for Comments",
  type="RFC",
  number="3401",
  year=2002,
  month=oct,
  issn="2070-1721",
