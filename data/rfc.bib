@misc{rfc3462,
  author="G. Vaudreuil",
  title="{The Multipart/Report Content Type for the Reporting of Mail System Administrative Messages}",
  howpublished="RFC 3462 (Draft Standard)",
  series="Internet Request for Comments",
  type="RFC",
  number="3462",
  year=2003,
