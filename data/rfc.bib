@misc{rfc3432,
  author="V. Raisanen and G. Grotefeld and A. Morton",
  title="{Network performance measurement with periodic streams}",
  howpublished="RFC 3432 (Proposed Standard)",
  series="Internet Request for Comments",
  type="RFC",
