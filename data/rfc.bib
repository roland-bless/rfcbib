@misc{rfc8895,
  author="W. Roome and Y. Yang",
  title="{Application-Layer Traffic Optimization (ALTO) Incremental Updates Using Server-Sent Events (SSE)}",
  howpublished="RFC 8895 (Proposed Standard)",
  series="Internet Request for Comments",
  type="RFC",
